{
  "name": "Python",
  "version": "1.0.0",
  "fileTypes": [
    "py",
    "pyi",
    "pyw"
  ],
  "scopeName": "source.python",
  "patterns": [
    {
      "include": "#main"
    }
  ],
  "repository": {
    "main": {
      "patterns": [
        {
          "name": "comment.line.number-sign.python",
          "match": "#.*$"
        },
        {
          "name": "string.interpolated.triple.double.python",
          "begin": "(?i)(?:f|fr|rf)\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.python",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "name": "meta.fstring.expression.python",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.ts"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.ts"
                }
              },
              "patterns": [
                {
                  "include": "#main"
                }
              ]
            },
            {
              "name": "constant.character.escape.python",
              "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|x[0-9A-Fa-f]{2}|.)"
            }
          ]
        },
        {
          "name": "string.interpolated.triple.single.python",
          "begin": "(?i)(?:f|fr|rf)'''",
          "end": "'''",
          "patterns": [
            {
              "name": "constant.character.escape.python",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "name": "meta.fstring.expression.python",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.ts"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.ts"
                }
              },
              "patterns": [
                {
                  "include": "#main"
                }
              ]
            },
            {
              "name": "constant.character.escape.python",
              "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|x[0-9A-Fa-f]{2}|.)"
            }
          ]
        },
        {
          "name": "string.interpolated.double.python",
          "begin": "(?i)(?:f|fr|rf)\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.python",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "name": "meta.fstring.expression.python",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.ts"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.ts"
                }
              },
              "patterns": [
                {
                  "include": "#main"
                }
              ]
            },
            {
              "name": "constant.character.escape.python",
              "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|x[0-9A-Fa-f]{2}|.)"
            }
          ]
        },
        {
          "name": "string.interpolated.single.python",
          "begin": "(?i)(?:f|fr|rf)'",
          "end": "'|$",
          "patterns": [
            {
              "name": "constant.character.escape.python",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "name": "meta.fstring.expression.python",
              "begin": "\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.begin.ts"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.definition.template-expression.end.ts"
                }
              },
              "patterns": [
                {
                  "include": "#main"
                }
              ]
            },
            {
              "name": "constant.character.escape.python",
              "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|x[0-9A-Fa-f]{2}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.triple.double.python",
          "begin": "(?i)(?:[rbu]|br|rb)?\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.python",
              "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|x[0-9A-Fa-f]{2}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.triple.single.python",
          "begin": "(?i)(?:[rbu]|br|rb)?'''",
          "end": "'''",
          "patterns": [
            {
              "name": "constant.character.escape.python",
              "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|x[0-9A-Fa-f]{2}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.double.python",
          "begin": "(?i)(?:[rbu]|br|rb)?\"",
          "end": "\"|$",
          "patterns": [
            {
              "name": "constant.character.escape.python",
              "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|x[0-9A-Fa-f]{2}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.single.python",
          "begin": "(?i)(?:[rbu]|br|rb)?'",
          "end": "'|$",
          "patterns": [
            {
              "name": "constant.character.escape.python",
              "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|x[0-9A-Fa-f]{2}|.)"
            }
          ]
        },
        {
          "name": "storage.type.annotation.python",
          "match": "^[ \\t]*@[A-Za-z_][A-Za-z0-9_.]*"
        },
        {
          "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.python"
            },
            "2": {
              "name": "entity.name.type.class.python"
            }
          }
        },
        {
          "match": "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.python"
            },
            "2": {
              "name": "entity.name.function.python"
            }
          }
        },
        {
          "name": "keyword.control.python",
          "match": "\\b(?:if|elif|else|for|while|break|continue|return|pass|try|except|finally|raise|with|as|yield|await|async|import|from|match|case|assert|del|global|nonlocal)\\b"
        },
        {
          "name": "keyword.operator.logical.python",
          "match": "\\b(?:and|or|not|in|is)\\b"
        },
        {
          "name": "storage.type.python",
          "match": "\\b(?:def|class|lambda)\\b"
        },
        {
          "name": "constant.language.python",
          "match": "\\b(?:True|False|None|NotImplemented|Ellipsis)\\b"
        },
        {
          "name": "variable.language.python",
          "match": "\\b(?:self|cls)\\b"
        },
        {
          "name": "support.function.builtin.python",
          "match": "\\b(?:abs|all|any|bool|bytes|callable|chr|dict|dir|enumerate|filter|float|format|frozenset|getattr|hasattr|hash|help|hex|id|input|int|isinstance|issubclass|iter|len|list|map|max|min|next|object|open|ord|pow|print|range|repr|reversed|round|set|setattr|slice|sorted|str|sum|super|tuple|type|vars|zip)\\b"
        },
        {
          "name": "constant.numeric.python",
          "match": "\\b(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?)[a-zA-Z0-9_]*\\b"
        },
        {
          "name": "support.class.python",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "entity.name.function.python",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*\\()"
        },
        {
          "name": "keyword.operator.python",
          "match": "[-+*/%=!<>&|^~?:]+"
        }
      ]
    }
  }
}
